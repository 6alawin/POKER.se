{
  "name": "poker-io",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "npx --yes turbo@2.10.9 run dev",
    "build": "npx --yes turbo@2.10.9 run build",
    "build:client": "npx --yes turbo@2.10.9 run build --filter=client",
    "build:server": "npx --yes turbo@2.10.9 run build --filter=server",
    "test": "npm --workspace server test",
    "visual:chat": "node scripts/chat-visual-check.mjs",
    "audit:chat-layout": "node scripts/chat-layout-audit.mjs"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "turbo": "^2.10.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vitest": "^4.1.10"
  }
}
